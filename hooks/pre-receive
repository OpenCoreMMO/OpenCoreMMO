#!/bin/bash

# Pre-receive hook for commit validation following Conventional Commits
# This hook runs on the Git server before accepting pushes

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function for logs
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Regex for Conventional Commits
CONVENTIONAL_COMMIT_REGEX="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?(!)?: .{1,72}$"

# Allowed types
ALLOWED_TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

# Allowed scopes for OpenCoreMMO
ALLOWED_SCOPES="protocol|outfit|combat|network|database|lua|api|core|test"

# Function to update changelog for commit
update_changelog_for_commit() {
    local commit_sha="$1"

    # Check if changelog update script exists
    if [[ ! -f "scripts/update-changelog.sh" ]]; then
        log_warning "Changelog update script not found, skipping changelog update"
        return 0
    fi

    # Check if CHANGELOG.md exists
    if [[ ! -f "CHANGELOG.md" ]]; then
        log_warning "CHANGELOG.md not found, skipping changelog update"
        return 0
    fi

    log_info "Updating changelog for commit $commit_sha..."

    # Run the changelog update script
    if ./scripts/update-changelog.sh --commit "$commit_sha"; then
        log_success "Changelog updated successfully"
        return 0
    else
        log_warning "Failed to update changelog for commit $commit_sha"
        return 0  # Don't fail the push for changelog issues
    fi
}

# Function to validate C# formatting
validate_commit_format() {
    local commit_msg="$1"
    local commit_sha="$2"

    # Check if message is empty
    if [[ -z "$commit_msg" ]]; then
        log_error "Commit $commit_sha: Empty commit message"
        return 1
    fi

    # Check basic format
    if ! [[ $commit_msg =~ $CONVENTIONAL_COMMIT_REGEX ]]; then
        log_error "Commit $commit_sha: Invalid format"
        echo "Message: '$commit_msg'"
        echo ""
        echo "Expected format: <type>[optional scope]: <description>"
        echo "Example: feat(outfit): add real-time outfit notifications"
        echo ""
        echo "Allowed types: $ALLOWED_TYPES"
        echo "Optional scopes: $ALLOWED_SCOPES"
        return 1
    fi

    # Extract type
    local type=$(echo "$commit_msg" | sed -E 's/^([a-z]+)(\(.+\))?(!)?: .*/\1/')

    # Check if type is allowed
    if ! [[ $type =~ ^($ALLOWED_TYPES)$ ]]; then
        log_error "Commit $commit_sha: Type '$type' not allowed"
        echo "Allowed types: $ALLOWED_TYPES"
        return 1
    fi

    # Extract scope if exists
    if [[ $commit_msg =~ \(([^)]+)\) ]]; then
        local scope="${BASH_REMATCH[1]}"

        # Check if scope is allowed
        if ! [[ $scope =~ ^($ALLOWED_SCOPES)$ ]]; then
            log_warning "Commit $commit_sha: Scope '$scope' not in recommended list"
            echo "Recommended scopes: $ALLOWED_SCOPES"
        fi
    fi

    # Check message length
    local msg_length=${#commit_msg}
    if [[ $msg_length -gt 72 ]]; then
        log_error "Commit $commit_sha: Message too long ($msg_length chars, max 72)"
        return 1
    fi

    return 0
}

# Função para verificar arquivos C#
validate_csharp_formatting() {
    local old_sha="$1"
    local new_sha="$2"

    # Verificar se há arquivos C# modificados
    local csharp_files=$(git diff --name-only "$old_sha" "$new_sha" | grep '\.cs$' | head -10)

    if [[ -n "$csharp_files" ]]; then
        log_info "Checking C# file formatting..."

        # Check if dotnet is available
        if ! command -v dotnet &> /dev/null; then
            log_warning "dotnet CLI not found. Skipping format verification."
            return 0
        fi

        # Run dotnet format in verification mode
        if dotnet format --verify-no-changes --verbosity quiet > /dev/null 2>&1; then
            log_success "C# formatting is correct"
        else
            log_error "C# files are not formatted correctly"
            echo "Run 'dotnet format' before pushing"
            return 1
        fi
    fi

    return 0
}

# Variáveis para estatísticas
TOTAL_COMMITS=0
VALID_COMMITS=0
INVALID_COMMITS=0

log_info "🔍 Starting commit validation..."

# Read pre-receive hook input
while read oldrev newrev refname; do
    log_info "Validating push to $refname ($oldrev..$newrev)"

    # If it's a new branch
    if [[ "$oldrev" == "0000000000000000000000000000000000000000" ]]; then
        oldrev="$(git rev-list --max-parents=0 $newrev)"
    fi

    # If it's branch removal
    if [[ "$newrev" == "0000000000000000000000000000000000000000" ]]; then
        log_info "Branch being removed, skipping validation"
        continue
    fi

    # Check C# formatting if applicable
    if ! validate_csharp_formatting "$oldrev" "$newrev"; then
        exit 1
    fi

    # Get commit list
    commits=$(git rev-list "$oldrev..$newrev")

    for commit in $commits; do
        TOTAL_COMMITS=$((TOTAL_COMMITS + 1))

        # Get commit message
        commit_msg=$(git log --format=%s -n 1 "$commit")
        commit_author=$(git log --format="%an <%ae>" -n 1 "$commit")

        log_info "Validating commit $commit by $commit_author"

        if validate_commit_format "$commit_msg" "$commit"; then
            VALID_COMMITS=$((VALID_COMMITS + 1))
            log_success "✅ $commit: '$commit_msg'"

            # Update changelog for this commit
            update_changelog_for_commit "$commit"
        else
            INVALID_COMMITS=$((INVALID_COMMITS + 1))
            log_error "❌ $commit: '$commit_msg'"
            echo ""
            echo "🚨 PUSH REJECTED: Commit does not follow Conventional Commits"
            echo ""
            echo "📚 Conventional Commits Guide:"
            echo "   feat: new feature"
            echo "   fix: bug fix"
            echo "   docs: documentation changes"
            echo "   style: formatting, semicolons, etc"
            echo "   refactor: refactoring without functionality change"
            echo "   perf: performance improvement"
            echo "   test: adding or fixing tests"
            echo "   build: build system changes"
            echo "   ci: CI/CD changes"
            echo "   chore: maintenance tasks"
            echo ""
            echo "📖 More info: https://www.conventionalcommits.org/"
            exit 1
        fi
    done
done

# Final statistics
echo ""
log_success "🎉 All commits passed validation!"
log_info "📊 Statistics:"
echo "   Total commits: $TOTAL_COMMITS"
echo "   Valid commits: $VALID_COMMITS"
echo "   Invalid commits: $INVALID_COMMITS"
echo ""

exit 0
