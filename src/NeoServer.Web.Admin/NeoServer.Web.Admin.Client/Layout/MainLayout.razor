@using MudBlazor.Utilities
@inherits LayoutComponentBase

@code{

    public bool IsDarkMode { get; set; } = false;
    public string LogoImage => IsDarkMode ? "/Opencoremmo-icon.png" : "/Opencoremmo-white.png";

    readonly MudTheme _theme = new()
    {
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = ["Montserrat", "Roboto", "sans-serif"]
            }
        },
        PaletteLight = new PaletteLight()
        {
            AppbarBackground = new MudColor("#105ed2")
        },
        PaletteDark = new PaletteDark()
        {
            AppbarBackground = new MudColor("#1e1e1e"),
            Background = new MudColor("#252525"),
            Primary = new MudColor("#89beff"),
            Surface = new MudColor("#2d2d31"),
            AppbarText = new MudColor("#939393")
        }
    };

}

<MudThemeProvider IsDarkMode="IsDarkMode" Theme="_theme"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudLayout>
    <MudAppBar Elevation="1">
        @* <MudStaticNavDrawerToggle DrawerId="nav-drawer" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"/> *@
        <MudImage Src="@LogoImage" Height="42" Style="margin-right: 15px"></MudImage>
        <MudText Typo="Typo.h6">Admin Dashboard</MudText>
        <MudSpacer/>
        @* <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End"/> *@
        <MudAvatar Color="Color.Info" Variant="Variant.Filled">CV</MudAvatar>
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu/>
    </MudDrawer>

    <MudMainContent Class="pt-16 pa-4" Style="display: flex; align-items: flex-start;">
        <div style="flex: 1; padding-top:5px; padding-left: 5px">
            <!-- Row layout for toggle and breadcrumbs -->
            <div style="display: flex; align-items: center; margin-bottom: 1rem;">
                <MudStaticNavDrawerToggle DrawerId="nav-drawer" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                                          Edge="Edge.Start"/>
                <MudBreadcrumbs Items="_items"/>
            </div>

            @Body
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private List<BreadcrumbItem> _items =
    [
        new("Home", href: "#"),
        new("Players", href: "#")
    ];

}