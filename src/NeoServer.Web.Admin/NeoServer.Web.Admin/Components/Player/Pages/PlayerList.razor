@page "/Players"
@attribute [ExcludeFromInteractiveRouting]
@using NeoServer.Web.API.Response
@using NeoServer.Web.API.Response.Player
@using NeoServer.Web.API.Requests.Queries
@using MediatR
@inject IMediator Mediator

<PageTitle>Players</PageTitle>

@if (Players?.Data is not null)
{
    <MudTable Items="Players?.Data" RowsPerPage="5" Bordered="true" Hover="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Level</MudTh>
            <MudTh>Online</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Level</MudTd>
            <MudTd>
                <MudChip T="string" Color="@(context.Online ? Color.Success : Color.Error)">
                    @(context.Online ? "Online" : "Offline")
                </MudChip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    
    private BasePagedResponseViewModel<IEnumerable<PlayerResponseViewModel>> Players { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        Players = await Mediator.Send(new GetPlayersRequest()
        {
            AccountId = 1,
            Limit = 10
        });
    }
}